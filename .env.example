# ==============================================================================
# CAYDENCE CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# NVIDIA NIM API Key (Required for story script generation)
# Obtain your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# Model selection for story generation:
# - meta/llama-3.2-11b-vision-instruct (Fast, recommended)
# - nvidia/llama-3.1-nemotron-ultra-253b-v1 (High fidelity)
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
